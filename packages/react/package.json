{
  "name": "@jflamb/keycaps-react",
  "version": "0.1.3",
  "description": "Owned React components for the Keycaps design system.",
  "license": "MIT",
  "homepage": "https://jflamb.github.io/keycaps-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jflamb/keycaps-design-system.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jflamb/keycaps-design-system/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "require": "./dist/static.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./static.css": "./dist/static.css"
  },
  "peerDependencies": {
    "@jflamb/keycaps-tokens": "^0.1.3",
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "dependencies": {
    "react-aria-components": "^1.20.0"
  },
  "devDependencies": {
    "@axe-core/react": "4.12.1",
    "@jflamb/keycaps-tokens": "workspace:*",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsup src/index.ts src/static.tsx --format esm,cjs --external react --external react-dom --clean && tsc -p tsconfig.build.json && cp src/styles.css src/static.css dist/",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run --coverage.enabled=false",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
