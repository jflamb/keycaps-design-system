{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/index.ts",
    "src/static.tsx",
    "src/components/**/*.tsx",
    "src/icons.tsx",
    "src/utils.ts"
  ],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.tsx", "src/test"]
}
