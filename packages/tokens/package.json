{
  "name": "@jflamb/keycaps-tokens",
  "version": "0.3.0",
  "description": "Framework-neutral Keycaps design tokens and locally hosted fonts.",
  "license": "MIT AND OFL-1.1",
  "homepage": "https://jflamb.github.io/keycaps-design-system/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jflamb/keycaps-design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/jflamb/keycaps-design-system/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "bin",
    "email-theme-v1.schema.json",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.css"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./prose.css": "./dist/prose.css",
    "./email-theme.json": "./dist/email-theme.json",
    "./email-theme-v1.schema.json": "./email-theme-v1.schema.json",
    "./legacy.css": "./dist/legacy.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "scripts": {
    "build": "node ../../scripts/build-tokens.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "keycaps-css-lint": "./bin/keycaps-css-lint.mjs"
  }
}
